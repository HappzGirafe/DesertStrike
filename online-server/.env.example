# Low Strike online server settings. Copy this file to .env (next to it) and fill it in.
# .env holds secrets: it is ignored by git and must never be committed, sent or put on the website.

# Your domain once you have bought it (e.g. at Infomaniak); until then any placeholder.
LOWSTRIKE_DOMAIN=example.com
# The address players' games use for the API: the Cloudflare Tunnel hostname. Also goes into docs/online.json.
PUBLIC_API_URL=https://api.example.com

# Where the API listens on this PC. Keep 127.0.0.1: only cloudflared reaches it.
API_HOST=127.0.0.1
API_PORT=8000
# The game hosts on this PC report here. Never point the tunnel at this port.
INTERNAL_PORT=8001

# The database file (accounts, friends, rooms). Back it up now and then.
DATABASE_PATH=./data/lowstrike.sqlite3

# Two different long random secrets. Make each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET protects the stored session tokens; GAME_JOIN_SECRET signs the tickets that let a player into a
# game host (the API passes it to the game hosts it starts, in their environment).
AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
GAME_JOIN_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET

# The game version players need for online rooms (Low Strike's version, e.g. 1.19). Empty = no check.
GAME_BUILD_VERSION=REPLACE_ME

# How long a login lasts: logged out after this many days without playing, and after SESSION_MAX_DAYS in any case.
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30

# One entry per game host = one room that can be played at the same time. Each needs its own local UDP port and
# its own playit.gg UDP tunnel to 127.0.0.1 and that port; public_udp_host/public_udp_port are the address playit
# gives the tunnel. (27115 rather than the LAN port 27015, so this PC can still host LAN games.)
# More rooms later: add entries (27125, 27135, ...) and a tunnel for each; nothing else changes.
ROOM_SLOTS_JSON=[{"id":"room-1","local_udp_port":27115,"public_udp_host":"YOUR_PLAYIT_HOST","public_udp_port":12345}]

# The Windows build of Low Strike that runs the game hosts (scripts\setup.ps1 fills it in from the server package's
# game folder). The API starts one host per slot and restarts any that stops.
UNITY_SERVER_EXECUTABLE=PATH_TO_UNITY_BUILD
# How the hosts run: without a window and without graphics.
UNITY_SERVER_ARGS=-batchmode -nographics

# Optional, for scripts\start.ps1 and install-autostart.ps1 (not needed when cloudflared runs as a Windows service):
# CLOUDFLARED_EXE=C:\Program Files (x86)\cloudflared\cloudflared.exe
# CLOUDFLARED_CONFIG=the config.yml of a tunnel made with "cloudflared tunnel create" (README step 3)
# CLOUDFLARED_TUNNEL_TOKEN=the token Cloudflare shows for a tunnel made in the dashboard (a secret)
# PLAYIT_EXE=C:\Program Files\playit_gg\bin\playit.exe

# Reviews on the website: the site addresses allowed to send one (comma-separated). Empty = the website's own
# (https://lowstrike.lokvetia.com and https://happzgirafe.github.io).
# REVIEW_ORIGINS=

# The admin panel (admin.py): the accounts that may use it, comma-separated. A name on the list without an account
# yet cannot be signed up by anyone. Default: 001,pups183,pups183mobile
# ADMIN_NICKS=001,pups183,pups183mobile
